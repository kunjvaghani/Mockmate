generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model MockInterview {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  userId         String
  jobRole        String
  jobDesc        String
  jobExperience  String
  createdAt      DateTime     @default(now())
  feedbackJson   String?      @db.String
  ended          Boolean      @default(false)
  duration       Int?
  questionCount  Int?         @default(5)
  interviewMode  String       @default("STANDARD") // "STANDARD" or "RESUME"
  resumeId       String?      @db.ObjectId
  messages       UserAnswer[]
}

model UserAnswer {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  mockInterviewId  String        @db.ObjectId
  mockInterview    MockInterview  @relation(fields: [mockInterviewId], references: [id])
  question         String
  userAnswer       String?
  aiFeedback       String?
  aiRating         Int?
  createdAt        DateTime      @default(now())
}

model UserResume {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String
  fileName     String
  fileSize     Int
  rawText      String   @db.String
  parsedRole   String?
  techStack    String?
  experience   String?
  skills       String[]
  summary      String?  @db.String
  projectsJson String?  @db.String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
